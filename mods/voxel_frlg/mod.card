return {
  summary = "The FireRed / LeafGreen overworld as a 3D diorama with a tilting, depth-buffered camera.",
  author = "Gen1Recomp community",
  contact = "https://github.com/bryanthaboi/gen1recomp",
  tags = { "graphics", "3d", "voxel", "render-pipeline", "presentation" },
  differences = {
    changed = {
      "with VOXEL on, the overworld draws as 3D geometry instead of flat tiles",
      "occlusion comes from a depth buffer rather than an OAM-priority sort",
      "trees, bushes, boulders and signs stand as sprite cards instead of boxes; buildings and rock stay solid",
      "turning VOXEL on switches TILT off, and turning TILT on switches VOXEL off",
      "outdoors the scene is lit by a sun (and moon) that moves with the time of day; interiors and caves are lit neutrally",
    },
    added = {
      "VOXEL options row under EXTRAS and hotkey 6 (OFF / 15 / 35 / 50 / 65 degrees)",
      "TIME options row under EXTRAS and hotkey 7 (REAL / CYCLE / DAY / DUSK / NIGHT / DAWN / OFF): day/night with sun and moon lighting, a sky, stars and lit windows at night",
    },
    known = {
      "lighting is per face with no cast shadows; window glow is a colour heuristic",
      "the camera does not rotate because movement is map-relative",
      "FireRed and LeafGreen only; Emerald is not claimed (untested there)",
    },
  },
  credits = {
    { who = "DramaticShape/DramaticShapeVoxelMod", for_ = "the render-pipeline approach and lib/Mat4.lua (MIT)" },
    { who = "ZallaxDev/pokeemerald-3Ds-dualscreen", for_ = "the idea of a voxel overworld on a Gen 3 field" },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
